rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.email.matches('.*admin.*') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }
    function isTenantOwner(tenantId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.tenantId == tenantId ||
        (exists(/databases/$(database)/documents/tenant_memberships/$(request.auth.uid + '_' + tenantId)) &&
         get(/databases/$(database)/documents/tenant_memberships/$(request.auth.uid + '_' + tenantId)).data.role in ['owner', 'admin'])
      );
    }

    match /platform_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    match /tenants/{tenantId} {
      allow read: if isAuthenticated();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || isTenantOwner(tenantId);
    }
    match /feature_registry/{featureKey} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    match /portfolio_projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantOwner(request.resource.data.tenantId));
    }
    match /leads/{leadId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && (
        isSuperAdmin() || isTenantOwner(resource.data.tenantId) || resource.data.customerId == request.auth.uid
      );
    }
    match /bookings/{bookingId} {
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated() && (
        isSuperAdmin() || isTenantOwner(resource.data.tenantId) || resource.data.customerId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (isSuperAdmin() || isTenantOwner(resource.data.tenantId));
    }
    match /client_projects/{projectId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || isTenantOwner(resource.data.tenantId) || resource.data.customerId == request.auth.uid
      );
      allow write: if isAuthenticated() && (isSuperAdmin() || isTenantOwner(request.resource.data.tenantId));
    }
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isTenantOwner(resource.data.tenantId));
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
